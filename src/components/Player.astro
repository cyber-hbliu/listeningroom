---
/**
 * Direct embed, lazy-loaded natively. Slim variants: bandcamp 42px,
 * soundcloud 20px mini bar, spotify 80px compact, apple 175px (no
 * smaller variant exists). Artist/release feed the iframe title.
 */
interface Props {
  platform: 'bandcamp' | 'soundcloud' | 'spotify' | 'apple';
  embedId: string;
  artist: string;
  release: string;
}
const { platform, embedId, artist, release } = Astro.props;

const src =
  platform === 'bandcamp'
    ? `https://bandcamp.com/EmbeddedPlayer/${embedId}/size=small/bgcol=f3eee3/linkcol=2140be/transparent=true/`
    : platform === 'soundcloud'
      ? `https://w.soundcloud.com/player/?url=${encodeURIComponent(embedId)}&color=%23e13d2b&visual=false&show_user=false&show_teaser=false`
      : platform === 'spotify'
        ? `https://open.spotify.com/embed/${embedId}?theme=0`
        : `https://embed.music.apple.com/${embedId}`;

const height =
  platform === 'bandcamp'
    ? 42
    : platform === 'soundcloud'
      ? 20
      : platform === 'spotify'
        ? 80
        : 175;
---
<iframe
  src={src}
  height={height}
  loading="lazy"
  title={`${artist} — ${release} (${platform} player)`}
  allow="autoplay; encrypted-media"
></iframe>
